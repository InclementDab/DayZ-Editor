   hexactsize 1
   vexactsize 1
   text "Items Placed"
   font "gui/fonts/Metron22"
   "size to text h" 1
   "text halign" center
   "text valign" center
  }
  TextWidgetClass Value {
   ignorepointer 1
   position 4 0
   size 48 22
   halign right_ref
   valign center_ref
