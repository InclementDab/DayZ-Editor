 vexactsize 1
 draggable 0
 scriptclass "EditorListItemController"
 style Colorable
 Padding 0
 Margin 0
 "Size To Content H" 1
 "Size To Content V" 1
 content_halign right
 content_valign center
 {
  ButtonWidgetClass ListItemButton {
   visible 1
   clipchildren 0
   ignorepointer 0
   color 0.753 0.369 0.326 1
   position 0 0
   size 1 1
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 0
   draggable 1
   scriptclass "ViewBinding"
   style Empty
   {
    TextWidgetClass ListItemLabel {
     visible 1
     disabled 0
     clipchildren 1
     ignorepointer 1
     position 24 0
     size 1 14
     valign center_ref
