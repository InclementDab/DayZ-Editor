       Binding_Name "Favorite"
       Two_Way_Binding 1
       Relay_Command "OnFavoriteToggle"
      }
     }
    }
   }
   {
    ScriptParamsClass {
     Relay_Command "ListItemExecute"
    }
   }
  }
 }
