     vexactpos 0
     hexactsize 0
     vexactsize 1
     draggable 0
     scriptclass "ViewBinding"
     style Normal
     text "CATEGORY"
     font "gui/fonts/sdf_MetronBook24"
     "bold text" 0
     "exact text" 0
     "exact text size" 12
     "size to text h" 1
     "size to text v" 1
     "text halign" center
     "text valign" center
     {
      ScriptParamsClass {
       Binding_Name "Label"
      }
     }
    }
    CheckBoxWidgetClass ListItemFavorites {
     visible 0
     inheritalpha 0
     color 1 0.843 0 1
     position 3 0
