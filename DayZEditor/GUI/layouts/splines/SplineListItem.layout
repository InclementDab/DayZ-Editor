PanelWidgetClass SplineListItem {
 visible 1
 ignorepointer 0
 color 0.141 0.157 0.18 1
 position 0 0
 size 1 24
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 1
 scaled 1
 style rover_sim_colorable
 {
  FrameWidgetClass IconFrame {
   ignorepointer 1
   position 0 0
   size 30 1
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 0
   scriptclass ""
   {
    ImageWidgetClass Icon {
     ignorepointer 1
     position 0 0
     size 16 16
     halign center_ref
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     scaled 1
     scriptclass "SymbolHandler"
     mode blend
     "src alpha" 1
     filter 1
     {
      ScriptParamsClass {
       Symbol_Name "bezier_curve"
       Symbol_Size 3
      }
     }
    }
   }
  }
  TextWidgetClass Label {
   ignorepointer 1
   position 30 0
   size 220 24
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   text "Spline"
   font "gui/fonts/Metron16"
   "exact text" 0
   "text valign" center
  }
  TextWidgetClass Detail {
   ignorepointer 1
   color 0.682 0.718 0.702 1
   position 252 0
   size 190 24
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   text ""
   font "gui/fonts/MetronBook16"
   "exact text" 0
   "text valign" center
   "text halign" right
  }
 }
}
